# Copy to config/.secrets.env and fill in. That file is gitignored.
# Each eToro API key is bound to ONE environment (demo or real) at creation time.

# --- eToro: WRITE key, used only by the scheduled trading run ---
ETORO_API_KEY=
ETORO_USER_KEY=

# --- eToro: READ-only key, used only by the webapp dashboard ---
ETORO_READ_API_KEY=
ETORO_READ_USER_KEY=

# --- eToro: DEMO pair, used by the forward test ---
ETORO_DEMO_API_KEY=
ETORO_DEMO_USER_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Inbound command auth (DESIGN §7.2): HMAC-of-(command, counter) ---
NIGHTWATCH_COMMAND_SECRET=
