# Copy to config/.secrets.env and fill in. That file is gitignored.
# Each eToro private key is bound to ONE environment (demo or real) at creation
# time. There is a single PUBLIC (user) key shared across every environment
# and role -- eToro issues one public key per account, not one per key pair.

# --- eToro: real-money WRITE private key, used only by the scheduled trading run ---
ETORO_PRIVATE_KEY=

# --- eToro: real-money READ-ONLY private key, used only by the webapp dashboard ---
ETORO_READ_PRIVATE_KEY=

# --- eToro: DEMO private key (full demo permissions), used by the forward test ---
ETORO_DEMO_PRIVATE_KEY=

# --- eToro: the single shared public (user) key -- same value for every
# environment and role above, so it is set once, not per-key ---
ETORO_PUBLIC_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Inbound command auth (DESIGN §7.2): HMAC-of-(command, counter). Must
# match the Worker's COMMAND_HMAC_SECRET. ---
NIGHTWATCH_COMMAND_SECRET=
