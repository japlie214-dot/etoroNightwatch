<?xml version="1.0" encoding="utf-8"?>
<!-- v2: root gets system-bar/cutout insets applied in code (MainActivity.applyInsets) rather
     than fitsSystemWindows, so we can pad top AND bottom precisely under edge-to-edge
     (mandatory for targetSdk 35+ on Android 15+). -->
<androidx.core.widget.NestedScrollView
    android:id="@+id/rootScroll"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnRequestExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant: Schedule exact alarms" />

        <Button
            android:id="@+id/btnRequestBatteryExemption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant: Ignore battery optimizations" />

        <Button
            android:id="@+id/btnRequestNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant: Notifications" />

        <View style="@style/Divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm test" />

        <EditText
            android:id="@+id/editFireMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fire in N minutes (default 2)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnScheduleTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule test alarm (setAlarmClock)" />

        <View style="@style/Divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nightly schedule"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPickedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 02:30 (device-local)" />

        <Button
            android:id="@+id/btnPickTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick time (analog clock)" />

        <LinearLayout
            android:id="@+id/dayToggleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <ToggleButton
                android:id="@+id/toggleMon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Mon" android:textOff="Mon"
                android:checked="true" />
            <ToggleButton
                android:id="@+id/toggleTue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Tue" android:textOff="Tue"
                android:checked="true" />
            <ToggleButton
                android:id="@+id/toggleWed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Wed" android:textOff="Wed"
                android:checked="true" />
            <ToggleButton
                android:id="@+id/toggleThu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Thu" android:textOff="Thu"
                android:checked="true" />
            <ToggleButton
                android:id="@+id/toggleFri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Fri" android:textOff="Fri"
                android:checked="true" />
            <ToggleButton
                android:id="@+id/toggleSat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Sat" android:textOff="Sat"
                android:checked="false" />
            <ToggleButton
                android:id="@+id/toggleSun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOn="Sun" android:textOff="Sun"
                android:checked="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnScheduleNightly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule nightly alarm (picked time + checked days)" />

        <Button
            android:id="@+id/btnScheduleMarket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule market session" />

        <TextView
            android:id="@+id/txtNextFireAbsolute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Next fire: (none scheduled)" />

        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textStyle="bold"
            android:text="Fires in: --" />

        <View style="@style/Divider" />

        <TextView
            android:id="@+id/txtFcmToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="FCM token: (not yet received)" />

        <TextView
            android:id="@+id/txtTz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="tzdata: (not yet run)" />

        <TextView
            android:id="@+id/txtFcmPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textColor="#B00020"
            android:text="FCM priority canary: (no message received yet)" />

        <TextView
            android:id="@+id/txtStandbyBucket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Standby bucket: (unknown)" />

        <Button
            android:id="@+id/btnRunChecksNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run FULL check battery now (selftest)" />

        <Button
            android:id="@+id/btnSendTelegramTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Telegram test message now" />

        <Button
            android:id="@+id/btnPushSnapshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Push snapshot to Worker now" />

        <View style="@style/Divider" />

        <!-- doc/RUNBOOK_DEVICE_PROBE.md: read-only sections A, C, D, E1, F (plus the sharpened E1
             per-trade fee audit) only. Section B (needs an open US market) is never triggered
             from this button; section E2 (places a real order) is not reachable from the UI at
             all: it exists only behind probe_live_2026_09_11.py's own e2 CLI flag, which
             nothing in this app ever passes. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live device probe (sections A, C, D, E1, F -- read-only)"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRunLiveProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run live probe now (A, C, D, E1, F: read-only, no order ever placed)" />

        <TextView
            android:id="@+id/txtLiveProbeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Live probe: (not yet run)" />

        <Button
            android:id="@+id/btnWindowBench"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run window bench (full-history vs 276-bar parse cost, no network)" />

        <TextView
            android:id="@+id/txtWindowBenchStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Window bench: (not yet run)" />

        <View style="@style/Divider" />

        <Button
            android:id="@+id/btnPlanAdoption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plan adoption (demo)" />

        <Button
            android:id="@+id/btnApplyAdoption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Apply adoption (demo)" />

        <TextView
            android:id="@+id/txtAdoptionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:text="Adoption: plan first; apply requires confirmation" />

        <View style="@style/Divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event log"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLogFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnShareLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share / export log" />

        <ListView
            android:id="@+id/listEvents"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:divider="#22000000"
            android:dividerHeight="1dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
